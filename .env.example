# --- База данных (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=app_db

# --- Веб-интерфейс pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme_admin_password

# --- Авторизация (JWT) ---
# Секретный ключ для подписи токенов (для продакшена сгенерируйте длинную случайную строку, например от 32 символов)
JWT_KEY=your_super_secret_jwt_key_min_32_chars_long
# Кто выпустил токен (обычно имя или URL вашего бэкенда)
JWT_ISSUER=my-api
# Для кого предназначен токен (обычно имя или URL клиентского приложения)
JWT_AUDIENCE=my-client
